{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Event Radar event",
  "type": "object",
  "required": ["id", "kategorija", "naslov", "datum", "prizorisce", "kraj", "viri"],
  "properties": {
    "id": {
      "type": "string",
      "description": "sha1(naslov|datum|prizorisce)"
    },
    "kategorija": {
      "type": "string",
      "enum": ["glasba", "kultura", "sport"]
    },
    "naslov": { "type": "string", "minLength": 1 },
    "datum": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "YYYY-MM-DD"
    },
    "ura": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{2}:[0-9]{2}$",
      "description": "HH:MM ali null"
    },
    "prizorisce": { "type": "string" },
    "kraj": { "type": "string" },
    "viri": {
      "type": "array",
      "items": { "type": "string", "format": "uri" },
      "minItems": 1
    },
    "opis": {
      "type": "string",
      "description": "1-2 stavka: kaj / kje / kdaj / kdo (doda analyst)"
    },
    "odmevnost": {
      "type": "object",
      "required": ["skupaj", "doseg", "prepoznavnost", "obisk", "redkost", "medijski_signal"],
      "properties": {
        "skupaj": { "type": "integer", "minimum": 0, "maximum": 100 },
        "doseg": { "type": "integer", "minimum": 0, "maximum": 5 },
        "prepoznavnost": { "type": "integer", "minimum": 0, "maximum": 5 },
        "obisk": { "type": "integer", "minimum": 0, "maximum": 5 },
        "redkost": { "type": "integer", "minimum": 0, "maximum": 5 },
        "medijski_signal": { "type": "integer", "minimum": 0, "maximum": 5 }
      }
    },
    "znacke": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 3
    }
  }
}
